// Recursos de Beneficio Unimax: ventanas (diálogos), menú, icono y manifiesto.
// Puede abrirse con el editor de recursos de Visual Studio.
#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_HONDURAS

IDI_APP ICON "app.ico"
IDB_LOGO BITMAP "logo_encabezado.bmp"

1 24 "app.manifest"

// Plantillas de Excel dentro del programa: así basta con descargar un solo .exe.
// Se copian a Documentos\BeneficioUnimax\Plantillas la primera vez.
IDR_PLT_FACTURA       RCDATA "../../plantillas/Factura.xlsx"
IDR_PLT_CIERRE_CAJA   RCDATA "../../plantillas/CierreCaja.xlsx"
IDR_PLT_ESTADO_CUENTA RCDATA "../../plantillas/EstadoCuenta.xlsx"
IDR_PLT_DEUDAS        RCDATA "../../plantillas/ReporteDeudas.xlsx"
IDR_PLT_COMPRAS       RCDATA "../../plantillas/ReporteCompras.xlsx"
IDR_PLT_VENTAS        RCDATA "../../plantillas/ReporteVentas.xlsx"
IDR_PLT_CAJA          RCDATA "../../plantillas/ReporteCaja.xlsx"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "480A04B0"
        BEGIN
            VALUE "CompanyName", "Beneficio Unimax"
            VALUE "FileDescription", "Beneficio Unimax - Contabilidad de compra de café"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "Beneficio Unimax"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "BeneficioUnimax.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x480A, 1200
    END
END

// =====================================================================  Menú
IDR_MENU MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Respaldar base de datos...", IDM_RESPALDAR
        MENUITEM "Abrir carpeta de &datos", IDM_CARPETA
        MENUITEM "Abrir carpeta de &plantillas de Excel", IDM_PLANTILLAS
        MENUITEM "&Instalar en esta computadora (ícono en el escritorio)", IDM_INSTALAR
        MENUITEM SEPARATOR
        MENUITEM "&Salir", IDM_SALIR
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Recordatorio de deudas de hoy", IDM_RECORDATORIO
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de Beneficio Unimax", IDM_ACERCA
    END
END

#define ESTILO_PAGINA DS_SETFONT | DS_CONTROL | DS_3DLOOK | WS_CHILD | WS_CLIPSIBLINGS
#define ESTILO_MODAL DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
#define LISTA LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP
#define COMBO CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
#define NUM ES_AUTOHSCROLL | ES_RIGHT

// =====================================================================  Comprobante de compra
IDD_PAG_FACTURA DIALOGEX 0, 0, 560, 298
STYLE ESTILO_PAGINA
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "1. Cliente (productor que vende el café)", IDC_STATIC, 6, 2, 548, 46
    LTEXT           "DNI:", IDC_STATIC, 14, 17, 18, 8
    EDITTEXT        IDC_F_DNI, 34, 15, 84, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Buscar...", IDC_F_BUSCAR, 122, 14, 46, 16
    LTEXT           "Nombre:", IDC_STATIC, 176, 17, 30, 8
    EDITTEXT        IDC_F_NOMBRE, 208, 15, 196, 14, ES_AUTOHSCROLL
    LTEXT           "Teléfono:", IDC_STATIC, 412, 17, 34, 8
    EDITTEXT        IDC_F_TELEFONO, 448, 15, 98, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_F_INFO, 14, 34, 532, 9

    LTEXT           "Comprobante No.:", IDC_STATIC, 8, 57, 62, 8
    LTEXT           "", IDC_F_NUMERO, 72, 55, 50, 11
    LTEXT           "Fecha:", IDC_STATIC, 128, 57, 24, 8
    CONTROL         "", IDC_F_FECHA, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 154, 54, 66, 14
    LTEXT           "", IDC_F_PRECIOS, 228, 57, 326, 9

    GROUPBOX        "2. Café pesado (el pago se calcula por libra; 1 quintal = 100 libras)", IDC_STATIC, 6, 72, 548, 50
    LTEXT           "Tipo de café:", IDC_STATIC, 14, 84, 60, 8
    COMBOBOX        IDC_F_TIPO, 14, 94, 92, 80, COMBO
    LTEXT           "Peso:", IDC_STATIC, 112, 84, 40, 8
    EDITTEXT        IDC_F_CANTIDAD, 112, 94, 52, 14, NUM
    COMBOBOX        IDC_F_UNIDAD, 166, 94, 58, 60, COMBO
    LTEXT           "Galones (dato):", IDC_STATIC, 230, 84, 56, 8
    EDITTEXT        IDC_F_GALONES, 230, 94, 50, 14, NUM
    LTEXT           "Precio por libra (L):", IDC_STATIC, 286, 84, 64, 8
    EDITTEXT        IDC_F_PRECIO, 286, 94, 58, 14, NUM
    LTEXT           "Subtotal:", IDC_STATIC, 352, 84, 80, 8
    LTEXT           "", IDC_F_SUBTOTAL, 352, 96, 84, 10
    LTEXT           "", IDC_F_PESO_INFO, 112, 110, 324, 9
    PUSHBUTTON      "Agregar línea", IDC_F_AGREGAR, 440, 92, 54, 16
    PUSHBUTTON      "Quitar línea", IDC_F_QUITAR, 496, 92, 52, 16

    CONTROL         "", IDC_F_LINEAS, "SysListView32", LISTA, 6, 126, 548, 82

    LTEXT           "TOTAL A PAGAR:", IDC_STATIC, 8, 217, 62, 8
    LTEXT           "", IDC_F_TOTAL, 72, 213, 260, 16
    LTEXT           "Pagado ahora en efectivo (L):", IDC_STATIC, 8, 237, 102, 8
    EDITTEXT        IDC_F_PAGADO, 112, 234, 72, 14, NUM
    LTEXT           "Saldo que queda debiendo el beneficio:", IDC_STATIC, 194, 237, 136, 8
    LTEXT           "", IDC_F_SALDO, 332, 237, 90, 9
    LTEXT           "Fecha de pago del saldo:", IDC_STATIC, 8, 255, 102, 8
    CONTROL         "", IDC_F_VENCE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 112, 252, 72, 14
    LTEXT           "(opcional) El saldo queda registrado como deuda y aparece en el recordatorio diario.", IDC_STATIC, 194, 255, 360, 9
    LTEXT           "Observaciones:", IDC_STATIC, 8, 273, 56, 8
    EDITTEXT        IDC_F_OBS, 66, 270, 270, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Guardar e imprimir", IDC_F_GUARDAR_IMP, 344, 268, 74, 18
    PUSHBUTTON      "Guardar", IDC_F_GUARDAR, 422, 268, 50, 18
    PUSHBUTTON      "Nuevo (limpiar)", IDC_F_LIMPIAR, 476, 268, 78, 18
END

