    CONTROL         "", IDC_N_VENCE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 234, 114, 82, 14
    LTEXT           "Concepto:", IDC_STATIC, 14, 134, 50, 8
    EDITTEXT        IDC_N_CONCEPTO, 70, 132, 246, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "El dinero sale o entra de la caja ahora", IDC_N_CAJA, 14, 152, 300, 10
    LTEXT           "", IDC_N_CAJA_INFO, 26, 164, 290, 26
    DEFPUSHBUTTON   "Guardar", IDOK, 218, 212, 50, 16
    PUSHBUTTON      "Cancelar", IDCANCEL, 273, 212, 50, 16
END

