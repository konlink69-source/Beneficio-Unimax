    PUSHBUTTON      "Desactivar", IDC_G_DESACTIVAR, 328, 161, 56, 16
    PUSHBUTTON      "Probar aviso ahora", IDC_G_PROBAR, 388, 161, 76, 16
    LTEXT           "", IDC_G_AVISO_ESTADO, 14, 184, 532, 20

    GROUPBOX        "Archivos", IDC_STATIC, 6, 214, 548, 56
    LTEXT           "", IDC_G_RUTA, 14, 226, 532, 18
    PUSHBUTTON      "Respaldar base de datos...", IDC_G_RESPALDAR, 14, 248, 100, 16
    PUSHBUTTON      "Abrir carpeta de datos", IDC_G_CARPETA, 118, 248, 90, 16
    PUSHBUTTON      "Guardar configuración", IDC_G_GUARDAR, 6, 276, 100, 18
END

