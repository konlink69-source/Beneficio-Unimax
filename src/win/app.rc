STYLE ESTILO_PAGINA
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

IDD_PAG_FACTURA DIALOGEX 0, 0, 560, 298
STYLE ESTILO_PAGINA
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "1. Cliente (productor que vende el café)", IDC_STATIC, 6, 2, 548, 46
    LTEXT           "DNI:", IDC_F_LBL_DNI, 12, 16, 26, 12
    EDITTEXT        IDC_F_DNI, 40, 14, 92, 15, ES_AUTOHSCROLL
    PUSHBUTTON      "Buscar por nombre...", IDC_F_BUSCAR, 135, 13, 76, 17
