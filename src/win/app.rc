// Recursos de Beneficio Unimax: ventanas (diálogos), menú, icono y manifiesto.
// Puede abrirse con el editor de recursos de Visual Studio.
#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_HONDURAS

IDI_APP ICON "app.ico"
IDB_LOGO BITMAP "logo_encabezado.bmp"
IDB_LOGO_DOC BITMAP "logo_documento.bmp"
IDB_MARCA1 BITMAP "marca1.bmp"
IDB_MARCA2 BITMAP "marca2.bmp"
// Marcas de agua para los documentos de Excel (PNG transparente)
IDR_MARCA_PNG1 RCDATA "../../logo/marca-agua-1.png"
IDR_MARCA_PNG2 RCDATA "../../logo/marca-agua-2.png"

1 24 "app.manifest"

// Plantillas de Excel dentro del programa: así basta con descargar un solo .exe.
// Se copian a Documentos\BeneficioUnimax\Plantillas la primera vez.
IDR_PLT_FACTURA       RCDATA "../../plantillas/Factura.xlsx"
IDR_PLT_CIERRE_CAJA   RCDATA "../../plantillas/CierreCaja.xlsx"
IDR_PLT_ESTADO_CUENTA RCDATA "../../plantillas/EstadoCuenta.xlsx"
IDR_PLT_DEUDAS        RCDATA "../../plantillas/ReporteDeudas.xlsx"
IDR_PLT_COMPRAS       RCDATA "../../plantillas/ReporteCompras.xlsx"
IDR_PLT_VENTAS        RCDATA "../../plantillas/ReporteVentas.xlsx"
IDR_PLT_CAJA          RCDATA "../../plantillas/ReporteCaja.xlsx"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "480A04B0"
        BEGIN
            VALUE "CompanyName", "Beneficio Unimax"
            VALUE "FileDescription", "Beneficio Unimax - Contabilidad de compra de café"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "Beneficio Unimax"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "BeneficioUnimax.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x480A, 1200
    END
END

// =====================================================================  Menú
IDR_MENU MENU
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Respaldar base de datos...", IDM_RESPALDAR
        MENUITEM "Abrir carpeta de &datos", IDM_CARPETA
        MENUITEM "Abrir carpeta de &plantillas de Excel", IDM_PLANTILLAS
        MENUITEM "&Instalar en esta computadora (ícono en el escritorio)", IDM_INSTALAR
        MENUITEM SEPARATOR
        MENUITEM "&Salir", IDM_SALIR
    END
    POPUP "&Sesión"
    BEGIN
        MENUITEM "Cambiar mi &contraseña...", IDM_CAMBIAR_CLAVE
        MENUITEM "&Usuarios...", IDM_USUARIOS
        MENUITEM SEPARATOR
        MENUITEM "Cerrar &sesión", IDM_CERRAR_SESION
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Recordatorio de deudas de hoy", IDM_RECORDATORIO
        MENUITEM "&Informe del día", IDM_INFORME
    END
    POPUP "&Nube"
    BEGIN
        MENUITEM "&Guardar en Google Drive ahora", IDM_NUBE_SINCRONIZAR
        MENUITEM "&Respaldos en Google Drive (ver y restaurar)...", IDM_NUBE_RESPALDOS
        MENUITEM "Google &Drive (conectar y estado)...", IDM_NUBE_CONFIGURAR
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Buscar actualizaciones del programa", IDM_ACTUALIZAR
        MENUITEM "&Acerca de Beneficio Unimax", IDM_ACERCA
    END
END

#define ESTILO_PAGINA DS_SETFONT | DS_CONTROL | DS_3DLOOK | WS_CHILD | WS_CLIPSIBLINGS
#define ESTILO_MODAL DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
#define LISTA LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP
#define COMBO CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
#define NUM ES_AUTOHSCROLL | ES_RIGHT

// =====================================================================  Comprobante de compra
