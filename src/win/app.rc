    EDITTEXT        IDC_F_CANTIDAD, 112, 94, 52, 14, NUM
    COMBOBOX        IDC_F_UNIDAD, 166, 94, 58, 60, COMBO
    LTEXT           "Galones (dato):", IDC_STATIC, 230, 84, 56, 8
    EDITTEXT        IDC_F_GALONES, 230, 94, 50, 14, NUM
    LTEXT           "Precio por libra (L):", IDC_STATIC, 286, 84, 64, 8
    EDITTEXT        IDC_F_PRECIO, 286, 94, 58, 14, NUM
